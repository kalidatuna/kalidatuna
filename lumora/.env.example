# ---- Lumora configuration (copy to .env) ----
BIND=0.0.0.0:8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=sqlite://data/lumora.db
CONTENT_DIR=../content
STATIC_DIR=../web/dist

# Comma-separated emails that become admins when they sign up (they get the /admin dashboard and Pro access).
ADMIN_EMAILS=you@example.com

# Set true when running behind a reverse proxy / load balancer (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=false
# Defaults to true when PUBLIC_URL starts with https://
# COOKIE_SECURE=true
AUTH_RATE_PER_MINUTE=20
SESSION_DAYS=30

# ---- Billing ----
# "demo" simulates checkout (no card charged). "stripe" takes real payments.
# If omitted, Stripe is used automatically when the keys below are present.
BILLING_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

RUST_LOG=info,tower_http=warn,sqlx=warn
